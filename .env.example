# 复制为 .env 后填值。.env 不进 git，权限建议 600。
# 优先级：进程环境 WG_* > .env > config.json > config.example.json
# 所有 key 只放这里；config.json 的 apiKey 一律留空。

WG_ACTIVE=deepseek

# 热加载：1 开（改完下一句就生效）/ 0 关（改完需重启）
WG_HOT_RELOAD=1

# --- DeepSeek（主力聊天）---
WG_DEEPSEEK_API_KEY=
# WG_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# WG_DEEPSEEK_CHAT_MODEL=deepseek-chat
# WG_DEEPSEEK_VISION_MODEL=
# WG_DEEPSEEK_TEMPERATURE=1.1

# --- 智谱（P1 的 VLM 用）---
WG_ZHIPU_API_KEY=
# WG_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# WG_ZHIPU_CHAT_MODEL=glm-4-flash
# WG_ZHIPU_VISION_MODEL=glm-4v-flash
# WG_ZHIPU_TEMPERATURE=1

# --- 本地 Ollama（占位 key，随便填但不能空）---
WG_CUSTOM_API_KEY=ollama
# WG_CUSTOM_BASE_URL=http://127.0.0.1:11434/v1
# WG_CUSTOM_CHAT_MODEL=qwen2.5:7b
# WG_CUSTOM_TEMPERATURE=1

# --- 服务 ---
# WG_HOST=127.0.0.1
# WG_PORT=8787
# WG_PERSONA=personas/whale.json
# WG_TIMEOUT_MS=60000
# --- 搜索（Tavily）---
# 注册后把 key 填这里，web_search 才能真的联网
WG_TAVILY_API_KEY=
# WG_SEARCH_ENDPOINT=https://api.tavily.com/search

# --- 工具循环 ---
# WG_MAX_ROUNDS=4

# --- 视觉（P1 图片消息走这个 provider 的 visionModel）---
# WG_VISION_PROVIDER=zhipu

# --- B站（P2d 子代理，只读阶段全留空也能跑）---
# buvid3 不用手抄：不填会自动向 B站 申领一个；填了就用你给的
WG_BILI_BUVID3=
# 下面三个从浏览器 Cookie 复制，供 AI 字幕/后续写操作用；只在 features.bili 启动时读入，改完需重启
WG_BILI_SESSDATA=
WG_BILI_BILI_JCT=
WG_BILI_DEDE_USER_ID=
