# 复制为 .env 后填值。.env 不进 git，key 只放这里。
# 优先级：进程环境 WG_* > .env > config.json > config.example.json

WG_ACTIVE=deepseek

# DeepSeek
WG_DEEPSEEK_API_KEY=
# WG_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# WG_DEEPSEEK_CHAT_MODEL=deepseek-chat

# 智谱（VLM 用）
# WG_ZHIPU_API_KEY=

# 本地 Ollama（key 随便填，别留空）
# WG_CUSTOM_BASE_URL=http://127.0.0.1:11434/v1
# WG_CUSTOM_API_KEY=ollama

# 热加载开关：1 开 / 0 关（关掉后改配置需重启）
# WG_HOT_RELOAD=1

# 服务地址
# WG_HOST=127.0.0.1
# WG_PORT=8787
